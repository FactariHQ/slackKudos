{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "Orange Dots",
    "description": "Peer recognition, one orange dot at a time.",
    "long_description": "Orange Dots is a peer-to-peer recognition app. Everyone gets a small, fixed number of orange dots to give away each period — so a dot means something, and nobody can spam them. Give one with /dot @someone and a reason, by typing the orange circle emoji in any channel, or by reacting with it. Dots build a leaderboard, unlock badges at milestones, and earn entries in a monthly raffle. Every dot carries a public reason, because the reason is the part people remember. Runs on your own Google Sheet, so the data stays in your Workspace.",
    "background_color": "#ff8a1f"
  },
  "features": {
    "bot_user": {
      "display_name": "Orange Dots",
      "always_online": true
    },
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "slash_commands": [
      {
        "command": "/dot",
        "url": "REPLACE_WITH_WEB_APP_URL",
        "description": "Give someone an orange dot",
        "usage_hint": "@someone what they did",
        "should_escape": true
      },
      {
        "command": "/dots",
        "url": "REPLACE_WITH_WEB_APP_URL",
        "description": "Your dots, the leaderboards, and how it all works",
        "usage_hint": "[leaderboard | month | all | given | @someone]",
        "should_escape": true
      },
      {
        "command": "/dot-admin",
        "url": "REPLACE_WITH_WEB_APP_URL",
        "description": "Orange Dots administration",
        "usage_hint": "status | grant | set | pause | draw",
        "should_escape": true
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "chat:write.public",
        "users:read",
        "users:read.email",
        "channels:read",
        "groups:read",
        "channels:history",
        "groups:history",
        "reactions:read",
        "app_mentions:read",
        "im:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "REPLACE_WITH_WEB_APP_URL",
      "bot_events": [
        "app_home_opened",
        "app_mention",
        "message.channels",
        "message.groups",
        "reaction_added",
        "team_join"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "REPLACE_WITH_WEB_APP_URL"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
